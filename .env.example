# Copy to .env for local development. Docker Compose reads these directly.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexuscollect
POSTGRES_USER=nexuscollect
POSTGRES_PASSWORD=nexuscollect
DATABASE_URL=postgres://nexuscollect:nexuscollect@localhost:5432/nexuscollect

# DEMO_MODE=true pins platform/clock to 2026-07-30T12:00:00+05:00 (Asia/Karachi).
DEMO_MODE=true

API_PORT=3000

# HS256 signing secret for resolution_token (platform/resolution-token). A demo
# value is fine locally; a real deployment must source this from a secrets
# manager, not a checked-in file.
RESOLUTION_TOKEN_SECRET=nexuscollect-demo-resolution-token-secret-do-not-use-in-prod

