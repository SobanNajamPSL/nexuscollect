# Recording intermediates and output. Playwright's WebM originals are the lossless
# source, kept locally for re-encoding. capture-problems.txt is debug output from a
# failed screenshot sweep.
docs/demo/recordings/*.webm
docs/demo/recordings/raw/
capture-problems.txt

# Narration takes. The recording sheets and the manifest are committed; the audio
# itself is large, is yours rather than the repo's, and is regenerable output once
# measured (durations.json / audio-files.json).
docs/demo/narration/audio/
docs/demo/narration/durations.json
docs/demo/narration/audio-files.json

# macOS
.DS_Store

# The recordings. The scripts that produce them are committed and are the
# authoritative version of the demonstration — see docs/demo/README.md. Keeping ~50 MB
# of video in history, re-committed on every re-record, was making the repository far
# heavier than the thing it demonstrates.
docs/demo/recordings/*.mp4
